# Classic preset — traditional compact launcher layout.
# Docked, no rounded corners, app list, sidebar on the right.
# Settings use the same Xfconf keys as the graphical Preferences window.

[Preset]
Name=Classic
SchemaVersion=1
Id=classic
Description=Traditional compact layout with the sidebar on the right and applications in a list.

[Settings]
layout-mode=docked
corner-radius=0
panel-gap=0
menu-width=450
menu-height=500
launcher-icon-size=2
category-icon-size=1
view-mode-default=list
sidebar-position=right
sidebar-enabled=true
category-show-name=true
search-bar-position=top
show-profile=true
show-session=true
menu-opacity=100
hover-switch-category=false
stay-on-focus-out=false
default-category=favorites
places-enabled=false
places-show-icons=false
places-switch-button-shape=gtk-theme
calculator-engine=none
calculator-result-font-size=-1
calculator-max-decimal-places=4
