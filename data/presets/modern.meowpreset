# Modern preset — contemporary layout with rounded corners, icon grid, sidebar on the left.
# Docked, hover-to-switch categories, search bar at the top.
# Settings use the same Xfconf keys as the graphical Preferences window.

[Preset]
Name=Modern
SchemaVersion=1
Id=modern
Description=Contemporary layout with rounded corners, categories on the left, and hover-to-switch enabled.

[Settings]
layout-mode=docked
corner-radius=12
panel-gap=8
menu-width=450
menu-height=500
launcher-icon-size=3
category-icon-size=1
view-mode-default=icons
grid-density=medium
sidebar-position=left
sidebar-enabled=true
category-show-name=true
search-bar-position=top
show-profile=true
show-session=true
menu-opacity=100
hover-switch-category=true
transparent-grid=true
stay-on-focus-out=false
default-category=recent
places-enabled=true
places-show-icons=true
places-switch-button-shape=gtk-theme
calculator-engine=bc
calculator-result-font-size=-1
calculator-max-decimal-places=4
