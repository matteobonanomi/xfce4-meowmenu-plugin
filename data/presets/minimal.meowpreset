# Minimal preset — compact, distraction-free launcher.
# Centered, sidebar-less, search bar on top over an app list; no profile or session buttons.
# Settings use the same Xfconf keys as the graphical Preferences window.

[Preset]
Name=Minimal
SchemaVersion=1
Id=minimal
Description=Compact, distraction-free launcher with no sidebar, profile, or session buttons.

[Settings]
corner-radius=12
panel-gap=8
menu-opacity=60
sidebar-position=left
sidebar-enabled=false
category-show-name=true
search-bar-position=top
show-profile=false
show-session=false
grid-density=medium
layout-mode=centered
launcher-icon-size=3
category-icon-size=1
view-mode-default=list
hover-switch-category=true
stay-on-focus-out=false
menu-width=450
menu-height=306
default-category=recent
places-enabled=true
places-show-icons=true
places-switch-button-shape=gtk-theme
calculator-engine=bc
calculator-result-font-size=-1
calculator-max-decimal-places=4
