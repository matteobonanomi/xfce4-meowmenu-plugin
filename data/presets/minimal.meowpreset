# Minimal preset — compact, distraction-free launcher.
# Centered, sidebar-less, search bar on top over an app list; no profile or commands.
# Source of truth for all keys: .specify/specs/003-properties-refactor/contracts/xfconf-keys.md

[Preset]
Name=Minimal
SchemaVersion=1
Id=minimal
Description=Compact, distraction-free launcher: a search bar over an app list, with no sidebar, profile, or command buttons.

[Settings]
corner-radius=12
panel-gap=8
menu-opacity=60
sidebar-position=left
sidebar-enabled=false
category-show-name=true
position-categories-horizontal=false
search-bar-position=top
profile-position=hidden
commands-position=hidden
grid-density=medium
layout-mode=centered
launcher-icon-size=3
category-icon-size=1
view-mode-default=list
hover-switch-category=true
unified-bar=false
stay-on-focus-out=false
menu-width=450
menu-height=306
default-category=recent
places-enabled=true
places-show-icons=true
places-switch-button-shape=gtk-theme
