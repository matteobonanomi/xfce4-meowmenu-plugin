# FullScreen preset — launcher fills the whole screen with a centered icon grid.
# Full-screen layout, sidebar on the left, larger icons, lower grid density.
# Settings use the same Xfconf keys as the graphical Preferences window.

[Preset]
Name=Full Screen
SchemaVersion=1
Id=fullscreen
Description=Launcher fills the whole screen with a centered grid and categories on the left.

[Settings]
layout-mode=fullscreen
corner-radius=0
panel-gap=0
launcher-icon-size=4
category-icon-size=2
view-mode-default=icons
grid-density=medium
sidebar-position=left
sidebar-enabled=true
category-show-name=true
search-bar-position=top
show-profile=true
show-session=true
menu-opacity=80
hover-switch-category=true
transparent-grid=true
stay-on-focus-out=false
default-category=all
places-enabled=true
places-show-icons=false
calculator-engine=bc
calculator-result-font-size=-1
calculator-max-decimal-places=4
