plugin_sources = [
  'launcher/applications-page.cpp',
  'launcher/application-load-generation.cpp',
  'presets/preset.cpp',
  'presets/preset-builtins.cpp',
  'presets/preset-io.cpp',
  'launcher/category.cpp',
  'launcher/category-button.cpp',
  'launcher/command.cpp',
  'ui/command-edit.cpp',
  'launcher/element.cpp',
  'launcher/favorites-page.cpp',
  'places/favourites-section.cpp',
  'places/history-section.cpp',
  'places/home-search-worker.cpp',
  'places/home-section.cpp',
  'ui/grid-cell-metrics.cpp',
  'ui/icon-renderer.cpp',
  'ui/icon-size.cpp',
  'ui/image-menu-item.h',
  'launcher/launcher.cpp',
  'ui/launcher-icon-view.cpp',
  'ui/launcher-tree-view.cpp',
  'migration.cpp',
  'launcher/page.cpp',
  'places/places-item.cpp',
  'places/places-page.cpp',
  'core/category-lifetime.cpp',
  'core/opacity-model.cpp',
  'core/plugin.cpp',
  'core/sidebar-layout.cpp',
  'core/theme-fallback.cpp',
  'core/user-session-layout.cpp',
  'core/user-session-relayout.cpp',
  'core/window-size-clamp.cpp',
  'core/window-frame.cpp',
  'profile.cpp',
  'search/query.cpp',
  'launcher/recent-page.cpp',
  'core/register-plugin.c',
  'core/resizer.cpp',
  'search/run-action.cpp',
  'search/search-action.cpp',
  'config/usage-stats.cpp',
  'search/search-page.cpp',
  'settings-reload-intent.cpp',
  'settings.cpp',
  'settings-bindings.cpp',
  'settings-defaults.cpp',
  'settings-dialog.cpp',
  'ui/properties/common.cpp',
  'ui/properties/general.cpp',
  'ui/properties/user-session.cpp',
  'ui/properties/search-bar.cpp',
  'ui/properties/search-bar-aliases.cpp',
  'ui/properties/search-bar-actions.cpp',
  'ui/properties/results-view.cpp',
  'ui/properties/sidebar.cpp',
  'ui/properties/places.cpp',
  'ui/slot.h',
  'ui/switch-icons.cpp',
  'core/window.cpp',
  'core/window-geometry.cpp',
  'core/window-keyboard.cpp',
  'core/window-pages.cpp',
  xfce_revision_h,
  meowmenu_version_h,
]

plugin_install_subdir = 'xfce4' / 'panel' / 'plugins'

plugin_lib = shared_module(
  'meowmenu',
  plugin_sources,
  gnu_symbol_visibility: 'hidden',
  cpp_args: [
    '-DG_LOG_DOMAIN="@0@"'.format('xfce4-meowmenu-plugin'),
    '-DSETTINGS_MENUFILE="@0@"'.format(get_option('sysconfdir') / 'xdg' / 'menus' / 'xfce-settings-manager.menu'),
  ],
  include_directories: [
    include_directories('..'),
    include_directories('.'),
  ],
  dependencies: [
    accountsservice,
    exo,
    garcon,
    gio,
    glib,
    gtk,
    gtk_layer_shell,
    libxfce4panel,
    libxfce4ui,
    libxfce4util,
    xfconf,
  ],
  install: true,
  install_dir: get_option('prefix') / get_option('libdir') / plugin_install_subdir,
)

popup_meowmenu_sources = [
  'core/xfce4-popup-meowmenu.cpp',
  xfce_revision_h,
]

popup_meowmenu = executable(
  'xfce4-popup-meowmenu',
  popup_meowmenu_sources,
  dependencies: [
    gio,
    glib,
    xfconf,
  ],
  install: true,
  install_dir: get_option('prefix') / get_option('bindir'),
)

i18n.merge_file(
  input: 'meowmenu.desktop.in',
  output: 'meowmenu.desktop',
  po_dir: '..' / 'po',
  type: 'desktop',
  install: true,
  install_dir: get_option('prefix') / get_option('datadir') / plugin_install_subdir,
)

install_man('core/xfce4-popup-meowmenu.1')
